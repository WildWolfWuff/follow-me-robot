<?xml version="1.0"?>
<sdf version="1.6">
  <actor name="actor">
    <!--
    inset this in the world file
    <include>
      <uri>model://actor</uri>
  </include> -->
    <skin>
      <filename>model://actor/meshes/SKIN_man_green_shirt.dae</filename>
      <scale>1.0</scale>
    </skin>
    <pose>0 1 0 0 0 0</pose>
    <animation name="walking">
      <filename>model://actor/meshes/ANIMATION_walking.dae</filename>
      <scale>1.000000</scale>
      <interpolate_x>true</interpolate_x>
    </animation>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.5 2 0.5</size>
          </box>
          <!-- <mesh>
            <uri>model://actor/meshes/SKIN_man_green_shirt.dae</uri>
          </mesh> -->
        </geometry>
      </collision>
    </link>
    <joint name="box_joint" type="fixed">
      <parent>link</parent>
      <child>box_link</child>
      <pose>0 0 0 0 0 0</pose>
    </joint>
    <link name="box_link">
      <visual name="visual">
        <geometry>
          <mesh>
            <scale>0.03 0.03 0.03</scale>
            <uri>model://april_tag0/meshes/apriltag0.obj</uri>
          </mesh>
        </geometry>
      </visual>
      <pose>0 0 0 0 -1.57 0</pose>
    </link>
    <script>
      <loop>true</loop>
      <delay_start>0.0</delay_start>
      <auto_start>true</auto_start>
      <trajectory id="0" type="walking">
        <waypoint>
          <time>0</time>
          <pose>0 1 0 0 0 0</pose>
        </waypoint>
        <waypoint>
          <!-- edge in -->
          <time>5</time>
          <pose>2.5 1 0 0 0 0</pose>
        </waypoint>
        <waypoint>
          <!-- edge 1 -->
          <time>10</time>
          <pose>4 0.7 0 0 0 -0.7</pose>
        </waypoint>
        <waypoint>
          <!-- edge out -->
          <time>15</time>
          <pose>5 -3 0 0 0 -1.57</pose>
        </waypoint>
        <waypoint>
          <time>45</time>
          <!-- edge in -->
          <pose>5 -11.5 0 0 0 -1.57</pose>
        </waypoint>
        <waypoint>
          <!-- edge 2 -->
          <time>50</time>
          <pose>4 -13.7 0 0 0 -2.45</pose>
        </waypoint>
        <waypoint>
          <!-- edge out -->
          <time>55</time>
          <pose>2 -14.5 0 0 0 -3.14</pose>
        </waypoint>
        <waypoint>
          <!-- edge in -->
          <time>70</time>
          <pose>-2 -14.5 0 0 0 -3.14</pose>
        </waypoint>
        <waypoint>
          <!-- edge 3 -->
          <time>75</time>
          <pose>-4 -13.7 0 0 0 -3.74</pose>
        </waypoint>
        <waypoint>
          <!-- edge out -->
          <time>80</time>
          <pose>-5 -11 0 0 0 -4.7</pose>
        </waypoint>
        <waypoint>
          <!-- edge in -->
          <time>105</time>
          <pose>-5 -1.5 0 0 0 -4.7</pose>
        </waypoint>
        <waypoint>
          <!-- edge 4 -->
          <time>110</time>
          <pose>-4 0.6 0 0 0 -5.35</pose>
        </waypoint>
        <waypoint>
          <!-- edge out -->
          <time>115</time>
          <pose>-2 1 0 0 0 -6.28</pose>
        </waypoint>
        <waypoint>
          <!-- end -->
          <time>120</time>
          <pose>0 1 0 0 0 -6.28</pose>
        </waypoint>
      </trajectory>
    </script>
  </actor>
</sdf>