<?xml version="1.0"?>
<robot xmlns="http://www.ros.org" name="robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="inertial.urdf.xacro" />
  <xacro:include filename="material.xacro" />
  <xacro:macro name="robot_body" params="parent wheel_radius body_length body_with body_heigth">
    <!-- Robot mechanical and motor parameters -->
    <joint name="base_link_joint" type="fixed">
      <parent link="${parent}" />
      <child link="base_link" />
      <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
    </joint>
    <!-- BASE_LINK (used by movement) -->
    <link name="base_link">
      <!-- Simple visual (use in windows foxglove) -->
      <!-- <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <material name="orange" />
        <geometry>
          <box size="${body_length} ${body_with} ${body_heigth}" />
        </geometry>
      </visual> -->
      
      <!-- Complex visual -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <material name="orange" />
        <geometry>
          <mesh filename="file://$(find follow_me_robot)/urdf/meshes/EXAM_robot_2022.stl" />
        </geometry>
      </visual>
      
      <!-- Collision -->
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0 " />
        <geometry>
          <box size="${body_length} ${body_with} ${body_heigth}" />
        </geometry>
      </collision>

      <!-- Inertial -->
      <inertial>
        <mass value="125.0" />
        <origin xyz="0 0 0" />
        <xacro:solid_cuboid_inertia m="125.0" h="${body_with}" d="${body_heigth}" w="${body_length}" />
      </inertial>
    </link>
  </xacro:macro>
</robot>