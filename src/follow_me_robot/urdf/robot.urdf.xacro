<?xml version="1.0"?>
<robot xmlns="http://www.ros.org" name="robot"
	xmlns:xacro="http://www.ros.org/wiki/xacro">
	<!-- Robot Size -->
	<xacro:property name="body_length" value="0.36" />
	<xacro:property name="body_with" value="0.19" />
	<xacro:property name="body_heigth" value="0.06" />
	<xacro:property name="wheel_height" value="0.04" />

	<!-- Wheel parameters -->
	<xacro:property name="wheel_offset_x" value="0.095" />
	<!-- x,y,z in translation from base_link to the center of the wheel -->
	<xacro:property name="wheel_offset_y" value="${(body_with/2)}" />
	<xacro:property name="wheel_offset_z" value="-0.01" />
	<xacro:property name="wheel_radius" value="0.045" />
	<xacro:property name="update_rate" value="30" />
	<xacro:property name="publish_rate" value="30" />
	
	<!-- Includes -->
	<xacro:include filename="core/material.xacro" />
	<xacro:materials />
	<xacro:include filename="core/omni_wheel.urdf.xacro" />
	<xacro:include filename="core/robot_body.urdf.xacro" />
	
	<!-- BASE FOOTPRINT -->
	<link name="base_footprint" />
	<!-- Robot Body -->
	<xacro:robot_body parent="base_footprint" wheel_radius="${wheel_radius}"
		body_length="${body_length}"
		body_with="${body_with}" body_heigth="${body_heigth}" />

	<!-- Wheel Front Right -->
	<xacro:wheel_motor parent="base_link" position="front" side="right" reflect="-1"
		wheel_img="2" wheel_height="${wheel_height}" wheel_radius="${wheel_radius}">
		<origin xyz="${wheel_offset_x} -${wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0.0" />
	</xacro:wheel_motor>
	<!-- Wheel Front Left -->
	<xacro:wheel_motor parent="base_link" position="front" side="left" reflect="1" wheel_img="2"
		wheel_height="${wheel_height}" wheel_radius="${wheel_radius}">
		<origin xyz="${wheel_offset_x} ${wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0" />
	</xacro:wheel_motor>
	<!-- Wheel Back Left -->
	<xacro:wheel_motor parent="base_link" position="back" side="left" reflect="1" wheel_img="1"
		wheel_height="${wheel_height}" wheel_radius="${wheel_radius}">
		<origin xyz="-${wheel_offset_x} ${wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0" />
	</xacro:wheel_motor>
	<!-- Wheel Back Right -->
	<xacro:wheel_motor parent="base_link" position="back" side="right" reflect="-1"
		wheel_img="1" wheel_height="${wheel_height}" wheel_radius="${wheel_radius}">
		<origin xyz="-${wheel_offset_x} -${wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0" />
	</xacro:wheel_motor>

	<!-- Lidar Sensor -->
	<xacro:include filename="sensors/lidar.xacro" />
	<xacro:lidar 
		parent="base_link"
		frame="base_link"
	 	update="${update_rate}"
		visualize="false"
		max_range="20"
		resolution="10"
		>
		<origin xyz="0 0 ${body_heigth/2+0.05}" rpy="0 0 0" />
	</xacro:lidar>

	<!-- IMU Sensor -->
	<xacro:include filename="sensors/imu.xacro" />
	<xacro:imu parent="base_link" frame="base_link" visualize="false" update="${update_rate}">
		<origin xyz="0 0 0" />
	</xacro:imu>
	
	<!-- Camera Sensor -->
	<xacro:include filename="sensors/camera.xacro" />
	<xacro:camera cam_name="front" parent="base_link" update="15"
		visualize="false">
		<origin xyz="${body_length/2} -0.0252 -0.005" rpy="0 -0.35 0" />
	</xacro:camera>

	<!-- <xacro:include filename="sensors/sonar.xacro" />
	<xacro:sonar sonar_name="front_mid" frame="base_link" parent="base_link"
		update="${update_rate}">
		<origin xyz="${body_length/2} 0 -0.05" rpy="0 0.2 0" />
	</xacro:sonar> -->

	<!-- Gazebo Plugins -->
	<gazebo>
		<!-- Plugin for the robot's movement -->
		<plugin name="psuedo_mecanum" filename="libgazebo_ros_planar_move.so">
			<command_topic>/cmd_vel</command_topic>
			<odometry_topic>/odom</odometry_topic>
			<odometry_frame>odom</odometry_frame>
			<robot_base_frame>base_link</robot_base_frame>
			<ground_truth>false</ground_truth>
			<control_mode>position</control_mode>
			<publish_odometry>false</publish_odometry>
			<publish_tf>false</publish_tf>
			<publish_imu>false</publish_imu>
			<publish_rate>0</publish_rate>
		</plugin>
		<!-- Plugin for the robot's joint state -->
		<plugin name="gazebo_ros_joint_state_publisher"
			filename="libgazebo_ros_joint_state_publisher.so">
			<update_rate>${update_rate}</update_rate>
			<joint_name>front_right_wheel_joint</joint_name>
			<joint_name>front_left_wheel_joint</joint_name>
			<joint_name>back_left_wheel_joint</joint_name>
			<joint_name>back_right_wheel_joint</joint_name>
		</plugin>
	</gazebo>

</robot>